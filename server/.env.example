# Copia este archivo a .env y ajusta los valores.
PORT=4000
NODE_ENV=development

# URL del frontend (para CORS y redirecciones de pago). Varias separadas por coma.
CLIENT_URL=http://localhost:5173
# URL pública de esta API; Mercado Pago la usa para avisar pagos (webhook). Opcional en local.
PUBLIC_API_URL=

# Cambia el secreto en producción: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES=8h

# Usuario del panel admin (se crea al iniciar si no existe)
ADMIN_EMAIL=admin@cumbre.co
ADMIN_PASSWORD=admin1234

# Datos de la tienda
STORE_NAME=Cumbre Tostadores
# Número de WhatsApp con indicativo de país, sin "+" (Colombia = 57)
STORE_WHATSAPP=573001234567
FREE_SHIPPING_FROM=150000
SHIPPING_FLAT=9000

# Mercado Pago (deja vacío para usar el pago simulado de demostración).
# Credenciales de prueba empiezan con TEST-
MP_ACCESS_TOKEN=
